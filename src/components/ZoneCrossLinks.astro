---
import { metroGroups, sortZonesByPriority, zoneNames } from '../data/zone-slugs';

interface Props {
  zone: string;      // slug: 'a-coruna'
  service: string;   // 'bano' | 'cocina' | 'integral'
}

const { zone, service } = Astro.props;

const serviceNames: Record<string, string> = {
  bano: 'Reforma de Baños',
  cocina: 'Reforma de Cocinas',
  integral: 'Reforma Integral',
};

const blogByService: Record<string, { name: string; url: string }> = {
  cocina: { name: 'Cuánto cuesta reformar una cocina en A Coruña', url: '/blog/cuanto-cuesta-reformar-cocina-a-coruna/' },
  bano: { name: 'Cuánto cuesta reformar un baño en A Coruña', url: '/blog/cuanto-cuesta-reformar-bano-a-coruna/' },
  integral: { name: 'Cuánto cuesta reformar un piso en A Coruña', url: '/blog/cuanto-cuesta-reformar-piso-a-coruna/' },
};

const group = Object.values(metroGroups).find((g) => g.includes(zone)) || [];
const neighbors = sortZonesByPriority(group.filter((z) => z !== zone));
const otherServices = Object.keys(serviceNames).filter((s) => s !== service);
const zoneName = zoneNames[zone] || zone;
const blog = blogByService[service];
---

<section class="zone-crosslinks">
  <div class="container">
    <div class="zc-grid">
      <div class="zc-col">
        <h3>También trabajamos en municipios cercanos</h3>
        <ul class="zc-neighbors">
          {neighbors.map((z) => (
            <li><a href={`/reforma-${service}-${z}/`}>{serviceNames[service]} en {zoneNames[z] || z}</a></li>
          ))}
        </ul>
      </div>
      <div class="zc-col">
        <h3>Otros servicios en {zoneName}</h3>
        <ul>
          {otherServices.map((s) => (
            <li><a href={`/reforma-${s}-${zone}/`}>{serviceNames[s]} en {zoneName}</a></li>
          ))}
          <li><a href="/servicios/">Ver todos los servicios</a></li>
        </ul>
      </div>
      {blog && (
        <div class="zc-col">
          <h3>Guía útil</h3>
          <ul>
            <li><a href={blog.url}>{blog.name}</a></li>
            <li><a href="/blog/">Ver todos los artículos</a></li>
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .zone-crosslinks {
    margin: 3rem auto;
    max-width: var(--container);
    padding: 0 20px;
  }
  .zc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .zc-col {
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--r-md);
    padding: 24px;
  }
  .zc-col h3 {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin-bottom: 14px;
    color: var(--ink);
  }
  .zc-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .zc-col a {
    color: var(--text-muted);
    font-size: .9rem;
    transition: color .2s;
  }
  .zc-col a:hover { color: var(--gold-ink-strong); }
  @media (max-width: 860px) {
    .zc-grid { grid-template-columns: 1fr; }
  }
</style>
