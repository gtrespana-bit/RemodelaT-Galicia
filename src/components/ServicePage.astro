---
/**
 * ServicePage — plantilla editorial de las páginas de servicio (/servicios/x/).
 *
 * Diseño: columna de lectura centrada (720–780 px) con cabeceras de sección
 * centradas, imágenes editoriales a ancho completo, bloques temáticos con
 * figura, proceso por fases, tabla de precios, errores comunes, proyectos
 * reales relacionados, FAQ amplia y zonas de trabajo. Todo el contenido llega
 * por props desde cada página de /servicios/*.astro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from './GodHero.astro';
import GodMarquee from './GodMarquee.astro';
import Breadcrumb from './Breadcrumb.astro';
import FAQ from './FAQ.astro';
import ServiceSchema from './ServiceSchema.astro';
import { corunaZones, zoneNames } from '../data/zone-slugs';
import { waLink } from '../data/brand';

export interface FaqItem { question: string; answer: string; }
export interface Figure { src: string; alt: string; caption?: string; }
export interface Topic {
  /** Título de la sección (h2). */
  title: string;
  /** Párrafos. Admiten <strong>, <em> y <a href="/ruta/"> sencillos. */
  paragraphs: string[];
  /** Lista de puntos opcional (admiten <strong>). */
  bullets?: string[];
  /** Imagen editorial opcional que acompaña a la sección. */
  figure?: Figure;
  /** Cita destacada opcional al final de la sección. */
  quote?: string;
}
export interface Phase { title: string; duration?: string; text: string; }
export interface Problem { title: string; problem: string; solution: string; }
export interface RelatedProject { slug: string; title: string; image: string; tag: string; }
export interface Highlight { label: string; value: string; }

interface Props {
  slug: string;
  title: string;
  titleGold: string;
  seoTitle?: string;
  description: string;
  eyebrow: string;
  lead: string;
  image: string;
  imageAlt: string;
  badges?: string[];
  watermark: string;
  crumb: string;
  /** Cifras clave del servicio (3–4). */
  highlights?: Highlight[];
  /** Introducción editorial (2–4 párrafos) + imagen de apertura. */
  introTitle?: string;
  intro: string[];
  introFigure?: Figure;
  /** Galería de referencias visuales (3 imágenes: 1 grande + 2 pequeñas). */
  gallery?: Figure[];
  galleryTitle?: string;
  galleryText?: string;
  /** Secciones temáticas largas. */
  topics: Topic[];
  /** Qué incluye. */
  includesTitle?: string;
  includesIntro?: string;
  includes: string[];
  /** Proceso por fases. */
  processTitle?: string;
  processIntro?: string;
  phases?: Phase[];
  /** Precios. */
  priceTitle?: string;
  priceIntro?: string;
  priceRows?: [string, string][];
  priceFactors?: string[];
  priceMethod?: string[];
  priceNote?: string;
  /** Problemas habituales y cómo se resuelven. */
  problemsTitle?: string;
  problemsIntro?: string;
  problems?: Problem[];
  /** Proyectos reales relacionados (obras previas en España). */
  relatedProjects?: RelatedProject[];
  /** Guías del blog relacionadas. */
  relatedGuides?: { title: string; url: string }[];
  /** FAQ (5–8 preguntas). */
  faqs: FaqItem[];
  /** Zonas: prefijo de las páginas de zona ('bano' | 'cocina' | 'integral'), si existen. */
  zoneService?: 'bano' | 'cocina' | 'integral';
  /** CTA final. */
  ctaTitle?: string;
  ctaText?: string;
  whatsappText?: string;
  schemaName: string;
  schemaType: string;
}

const {
  slug, title, titleGold, seoTitle, description, eyebrow, lead, image, imageAlt,
  badges = [], watermark, crumb, highlights = [],
  introTitle, intro, introFigure,
  gallery = [], galleryTitle = 'Referencias visuales', galleryText,
  topics = [],
  includesTitle = 'Qué incluye', includesIntro, includes,
  processTitle = 'Cómo trabajamos, paso a paso', processIntro, phases = [],
  priceTitle = 'Cuánto cuesta: depende de tu proyecto', priceIntro, priceRows = [], priceFactors = [], priceMethod = [], priceNote,
  problemsTitle = 'Problemas habituales y cómo los resolvemos', problemsIntro, problems = [],
  relatedProjects = [], relatedGuides = [],
  faqs, zoneService,
  ctaTitle, ctaText, whatsappText,
  schemaName, schemaType,
} = Astro.props;

const pageTitle = seoTitle ?? `${title} ${titleGold} | RemodelaT Coruña`;
const waHref = waLink(whatsappText ?? `Hola, quiero información sobre ${crumb.toLowerCase()} en A Coruña`);

const sections = [
  { id: 'introduccion', label: 'El servicio' },
  ...(topics.length ? [{ id: 'detalle', label: 'En detalle' }] : []),
  { id: 'que-incluye', label: 'Qué incluye' },
  ...(phases.length ? [{ id: 'proceso', label: 'Proceso' }] : []),
  ...((priceRows.length || priceFactors.length) ? [{ id: 'presupuesto', label: 'Presupuesto' }] : []),
  ...(problems.length ? [{ id: 'problemas', label: 'Errores que evitamos' }] : []),
  ...(relatedProjects.length ? [{ id: 'proyectos', label: 'Obras reales' }] : []),
  { id: 'faq', label: 'Preguntas' },
];

const ctaHeadline = ctaTitle ?? `¿Empezamos con tu ${crumb.toLowerCase()}?`;
const ctaCopy = ctaText ?? 'Cuéntanos tu proyecto en A Coruña y te enviamos un presupuesto por partidas, claro y cerrado.';
---

<BaseLayout
  title={pageTitle}
  description={description}
  image={image}
  activePage="servicios"
>
  <GodHero
    eyebrow={eyebrow}
    title={title}
    titleGold={titleGold}
    lead={lead}
    image={image}
    imageAlt={imageAlt}
    badges={badges}
    watermark={watermark}
    backLink={{ href: '/servicios/', label: 'Todos los servicios' }}
    align="center"
  />

  <GodMarquee />

  <Breadcrumb items={[
    { name: 'Inicio', url: '/' },
    { name: 'Servicios', url: '/servicios/' },
    { name: crumb, url: `/servicios/${slug}/` }
  ]} />

  <!-- Índice de la página -->
  <nav class="svc-toc" aria-label="Contenido de esta página">
    <div class="svc-toc-inner">
      <span class="svc-toc-label">En esta página</span>
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
      </ul>
    </div>
  </nav>

  {highlights.length > 0 && (
    <section class="svc-highlights" aria-label="Datos clave del servicio">
      <dl class="svc-highlights-grid">
        {highlights.map((h) => (
          <div class="svc-highlight">
            <dd>{h.value}</dd>
            <dt>{h.label}</dt>
          </div>
        ))}
      </dl>
    </section>
  )}

  <!-- ============ INTRODUCCIÓN ============ -->
  <section class="svc-section svc-intro" id="introduccion">
    <div class="svc-reading">
      <header class="svc-header">
        <span class="eyebrow-god on-light">El servicio</span>
        <h2>{introTitle ?? `${crumb} en A Coruña, bien hecha y documentada`}</h2>
      </header>
      <div class="svc-prose svc-prose-dropcap">
        {intro.map((p) => <p set:html={p} />)}
      </div>
    </div>
    {introFigure && (
      <figure class="svc-figure svc-figure-wide">
        <img src={introFigure.src} alt={introFigure.alt} loading="lazy" decoding="async" />
        {introFigure.caption && <figcaption>{introFigure.caption}</figcaption>}
      </figure>
    )}
  </section>

  {gallery.length >= 3 && (
    <section class="svc-section svc-gallery-section" aria-label={galleryTitle}>
      <div class="svc-reading">
        <header class="svc-header">
          <span class="eyebrow-god on-light">Inspiración</span>
          <h2>{galleryTitle}</h2>
          {galleryText && <p class="svc-header-text">{galleryText}</p>}
        </header>
      </div>
      <div class="svc-gallery">
        <figure class="svc-gallery-item large">
          <img src={gallery[0].src} alt={gallery[0].alt} loading="lazy" decoding="async" />
          {gallery[0].caption && <figcaption>{gallery[0].caption}</figcaption>}
        </figure>
        <figure class="svc-gallery-item">
          <img src={gallery[1].src} alt={gallery[1].alt} loading="lazy" decoding="async" />
          {gallery[1].caption && <figcaption>{gallery[1].caption}</figcaption>}
        </figure>
        <figure class="svc-gallery-item">
          <img src={gallery[2].src} alt={gallery[2].alt} loading="lazy" decoding="async" />
          {gallery[2].caption && <figcaption>{gallery[2].caption}</figcaption>}
        </figure>
      </div>
    </section>
  )}

  <!-- ============ SECCIONES TEMÁTICAS ============ -->
  {topics.length > 0 && (
    <section class="svc-section svc-topics" id="detalle">
      <div class="svc-reading">
        <header class="svc-header">
          <span class="eyebrow-god on-light">En detalle</span>
          <h2>Lo que marca la diferencia en {crumb.toLowerCase()}</h2>
        </header>
      </div>
      {topics.map((t, i) => (
        <article class="svc-topic">
          <div class="svc-reading">
            <span class="svc-topic-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t.title}</h3>
            <div class="svc-prose">
              {t.paragraphs.map((p) => <p set:html={p} />)}
              {t.bullets && t.bullets.length > 0 && (
                <ul class="svc-checks">
                  {t.bullets.map((b) => <li set:html={b} />)}
                </ul>
              )}
            </div>
          </div>
          {t.figure && (
            <figure class="svc-figure">
              <img src={t.figure.src} alt={t.figure.alt} loading="lazy" decoding="async" />
              {t.figure.caption && <figcaption>{t.figure.caption}</figcaption>}
            </figure>
          )}
          {t.quote && (
            <div class="svc-reading">
              <blockquote class="svc-quote"><p>{t.quote}</p></blockquote>
            </div>
          )}
        </article>
      ))}
    </section>
  )}

  <!-- ============ QUÉ INCLUYE ============ -->
  <section class="svc-section svc-includes" id="que-incluye">
    <div class="svc-reading">
      <header class="svc-header">
        <span class="eyebrow-god on-light">Alcance</span>
        <h2>{includesTitle}</h2>
        {includesIntro && <p class="svc-header-text">{includesIntro}</p>}
      </header>
    </div>
    <ul class="svc-includes-grid">
      {includes.map((i) => (
        <li class="svc-include">
          <span class="svc-include-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <span set:html={i} />
        </li>
      ))}
    </ul>
  </section>

  <!-- ============ PROCESO ============ -->
  {phases.length > 0 && (
    <section class="svc-section svc-process" id="proceso">
      <div class="svc-reading">
        <header class="svc-header on-dark">
          <span class="eyebrow-god">Método RemodelaT</span>
          <h2>{processTitle}</h2>
          {processIntro && <p class="svc-header-text">{processIntro}</p>}
        </header>
      </div>
      <ol class="svc-phases">
        {phases.map((ph, i) => (
          <li class="svc-phase">
            <span class="svc-phase-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="svc-phase-body">
              <h3>{ph.title}</h3>
              {ph.duration && <span class="svc-phase-duration">{ph.duration}</span>}
              <p set:html={ph.text} />
            </div>
          </li>
        ))}
      </ol>
      <div class="svc-process-link">
        <a href="/metodo-remodelat/" class="btn-premium btn-outline-premium"><span class="btn-content">Ver el método completo</span><span class="btn-arrow">→</span></a>
      </div>
    </section>
  )}

  <!-- ============ PRESUPUESTO ============ -->
  {(priceRows.length > 0 || priceFactors.length > 0) && (
    <section class="svc-section svc-prices" id="presupuesto">
      <div class="svc-reading">
        <header class="svc-header">
          <span class="eyebrow-god on-light">Presupuesto</span>
          <h2>{priceTitle}</h2>
          {priceIntro && <p class="svc-header-text">{priceIntro}</p>}
        </header>
        {priceRows.length > 0 && (
          <div class="svc-table-wrap">
            <table class="svc-table">
              <thead><tr><th>Alcance</th><th>Precio orientativo</th></tr></thead>
              <tbody>
                {priceRows.map(([label, price]) => (
                  <tr><td>{label}</td><td class="svc-price">{price}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {priceFactors.length > 0 && (
          <div class="svc-factors">
            <h3>Qué determina el precio</h3>
            <ul class="svc-checks">
              {priceFactors.map((f) => <li set:html={f} />)}
            </ul>
          </div>
        )}
        {priceMethod.length > 0 && (
          <div class="svc-factors svc-factors--method">
            <h3>Cómo te damos el precio</h3>
            <ul class="svc-checks">
              {priceMethod.map((f) => <li set:html={f} />)}
            </ul>
          </div>
        )}
        {priceNote && <p class="svc-price-note">{priceNote}</p>}
      </div>
    </section>
  )}

  <!-- ============ PROBLEMAS HABITUALES ============ -->
  {problems.length > 0 && (
    <section class="svc-section svc-problems" id="problemas">
      <div class="svc-reading">
        <header class="svc-header">
          <span class="eyebrow-god on-light">Experiencia en obra</span>
          <h2>{problemsTitle}</h2>
          {problemsIntro && <p class="svc-header-text">{problemsIntro}</p>}
        </header>
      </div>
      <div class="svc-problems-grid">
        {problems.map((p) => (
          <article class="svc-problem">
            <h3>{p.title}</h3>
            <p><span class="svc-problem-label">El problema</span>{p.problem}</p>
            <p><span class="svc-problem-label is-solution">Cómo lo resolvemos</span>{p.solution}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- ============ PROYECTOS REALES ============ -->
  {relatedProjects.length > 0 && (
    <section class="svc-section svc-projects" id="proyectos">
      <div class="svc-reading">
        <header class="svc-header">
          <span class="eyebrow-god on-light">Obras reales</span>
          <h2>Casos documentados paso a paso</h2>
          <p class="svc-header-text">Obras previas ejecutadas por nuestro fundador en España, con fotografías reales de cada fase. Así trabajamos también en A Coruña.</p>
        </header>
      </div>
      <div class="svc-projects-grid">
        {relatedProjects.map((p) => (
          <a href={`/proyectos/${p.slug}/`} class="svc-project-card">
            <div class="svc-project-img">
              <img src={p.image} alt={p.title} loading="lazy" decoding="async" />
              <span class="svc-project-tag">{p.tag}</span>
            </div>
            <div class="svc-project-body">
              <h3>{p.title}</h3>
              <span class="svc-project-link">Ver el caso completo <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <div class="svc-process-link">
        <a href="/proyectos/" class="btn-premium btn-outline-premium on-light"><span class="btn-content">Ver todos los proyectos</span><span class="btn-arrow">→</span></a>
      </div>
    </section>
  )}

  <!-- ============ FAQ ============ -->
  <section class="svc-section svc-faq" id="faq">
    <div class="svc-reading">
      <header class="svc-header">
        <span class="eyebrow-god on-light">Preguntas frecuentes</span>
        <h2>Resolvemos tus dudas sobre {crumb.toLowerCase()}</h2>
      </header>
      <FAQ items={faqs} title="" />
      {relatedGuides.length > 0 && (
        <div class="svc-guides">
          <span class="svc-guides-label">Guías relacionadas</span>
          <ul>
            {relatedGuides.map((g) => <li><a href={g.url}>{g.title}</a></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- ============ ZONAS ============ -->
  <section class="svc-section svc-zones" aria-label="Zonas de trabajo">
    <div class="svc-reading">
      <header class="svc-header">
        <span class="eyebrow-god on-light">Zona de trabajo</span>
        <h2>A Coruña y área metropolitana</h2>
        <p class="svc-header-text">Trabajamos en la ciudad de A Coruña y en los municipios de su área metropolitana, con el mismo método y la misma garantía por escrito.</p>
      </header>
      <div class="svc-zone-chips">
        {corunaZones.map((z) => (
          zoneService
            ? <a href={`/reforma-${zoneService}-${z}/`}>{zoneNames[z]}</a>
            : <span>{zoneNames[z]}</span>
        ))}
      </div>
    </div>
  </section>

  <ServiceSchema
    name={schemaName}
    description={description}
    serviceType={schemaType}
    image={image}
  />

  <section class="god-cta">
    <div class="cta-wrapper">
      <span class="eyebrow-god">Presupuesto por partidas</span>
      <h2 class="cta-title">{ctaHeadline}</h2>
      <p class="cta-text">{ctaCopy}</p>
      <div class="svc-cta-actions">
        <a href="/contacto/" class="btn-premium btn-primary-premium"><span class="btn-content">Solicitar presupuesto</span><span class="btn-arrow">→</span></a>
        <a href={waHref} class="btn-premium btn-outline-premium" target="_blank" rel="noopener"><span class="btn-content">WhatsApp</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Sistema de lectura centrado ---------- */
  .svc-reading { max-width: 780px; margin: 0 auto; padding: 0 24px; }
  .svc-section { padding: clamp(64px, 8vw, 110px) 0; }
  .svc-section + .svc-section { padding-top: 0; }

  .svc-header { text-align: center; margin: 0 auto 40px; }
  .svc-header .eyebrow-god { margin-bottom: 18px; }
  .svc-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.9rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    margin: 0 auto;
    max-width: 22ch;
    text-wrap: balance;
  }
  .svc-header-text {
    color: var(--text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
    margin: 18px auto 0;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .svc-header.on-dark h2 { color: var(--white); }
  .svc-header.on-dark .svc-header-text { color: rgba(255,255,255,.72); }

  /* Eyebrow centrado: la línea decorativa va a ambos lados */
  .svc-header .eyebrow-god { justify-content: center; }
  .svc-header .eyebrow-god::after {
    content: ""; display: block; width: 28px; height: 1px; background: currentColor; opacity: .9;
  }

  /* ---------- Prosa ---------- */
  .svc-prose { font-size: 1.13rem; line-height: 1.85; color: var(--text); text-wrap: pretty; }
  .svc-prose p { margin-bottom: 1.35rem; }
  .svc-prose p:last-child { margin-bottom: 0; }
  .svc-prose :global(strong) { font-weight: 700; color: var(--ink-soft); }
  .svc-prose :global(a) { color: var(--gold-ink-strong); border-bottom: 1px solid rgba(138,109,31,.45); transition: border-color var(--dur-fast) var(--ease-out); }
  .svc-prose :global(a:hover) { border-bottom-color: var(--gold-ink-strong); }
  .svc-prose-dropcap > p:first-of-type::first-letter {
    font-family: var(--font-serif); font-size: 4.4rem; font-weight: 600; float: left;
    line-height: .78; margin: 8px .14em 0 0; color: var(--gold-ink);
  }

  .svc-checks { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; gap: 12px; }
  .svc-checks li { position: relative; padding-left: 30px; font-size: 1.05rem; line-height: 1.7; color: var(--text); }
  .svc-checks li::before {
    content: ""; position: absolute; left: 0; top: .62em; width: 16px; height: 1px; background: var(--gold-ink);
  }
  .svc-checks :global(strong) { color: var(--ink-soft); }

  .svc-quote {
    margin: 40px auto 0; padding: 28px 32px; text-align: center;
    border-top: 1px solid rgba(201,169,97,.35); border-bottom: 1px solid rgba(201,169,97,.35);
  }
  .svc-quote p { font-family: var(--font-serif); font-size: clamp(1.35rem, 2.4vw, 1.7rem); line-height: 1.4; color: var(--ink); font-style: italic; margin: 0; text-wrap: balance; }

  /* ---------- Figuras ---------- */
  .svc-figure { max-width: 1080px; margin: 48px auto 0; padding: 0 24px; }
  .svc-figure img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block;
    border-radius: var(--r-god); box-shadow: var(--e-3);
  }
  .svc-figure figcaption { text-align: center; color: var(--text-muted); font-size: .9rem; margin-top: 14px; font-style: italic; }
  .svc-figure-wide { margin-top: 56px; }

  /* ---------- Índice ---------- */
  .svc-toc { max-width: 1200px; margin: 6px auto 0; padding: 0 clamp(20px, 4vw, 48px); }
  .svc-toc-inner {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 14px;
    padding: 14px 18px; border: 1px solid rgba(201,169,97,.25); border-radius: var(--r-god);
    background: var(--bone);
  }
  .svc-toc-label { font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-ink); margin-right: 6px; }
  .svc-toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .svc-toc a {
    display: inline-flex; align-items: center; min-height: 34px; padding: 4px 14px; border-radius: var(--r-full);
    background: var(--white); border: 1px solid rgba(201,169,97,.22); color: var(--text);
    font-size: .78rem; font-weight: 700; letter-spacing: .04em;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .svc-toc a:hover { color: var(--gold-ink-strong); border-color: rgba(201,169,97,.55); transform: translateY(-1px); }

  /* ---------- Cifras clave ---------- */
  .svc-highlights { max-width: 1080px; margin: 44px auto 0; padding: 0 24px; }
  .svc-highlights-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin: 0;
    border: 1px solid rgba(201,169,97,.25); border-radius: var(--r-god); overflow: hidden;
