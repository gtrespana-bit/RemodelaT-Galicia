  problemsIntro="Lo que nos encontramos cuando nos llaman para repintar algo pintado hace poco."
  problems={[
    { title: "Moho que vuelve tras pintar", problem: "Se pinta encima del moho con pintura normal. En el primer invierno húmedo de A Coruña, reaparece.", solution: "Tratamiento fungicida, corrección de la causa (ventilación, puente térmico) y pintura antimoho con aditivo fungicida." },
    { title: "Grietas que reabren", problem: "Grieta tapada con masilla y pintada. A los meses vuelve a marcarse porque la pared sigue moviéndose.", solution: "Apertura de la grieta, malla de fibra, masilla elástica y plastecido. Si la grieta es estructural, lo decimos antes de pintar." },
    { title: "Marcas de rodillo y cortes visibles", problem: "Pintura aplicada sin imprimación, con rodillo inadecuado o sin mantener el borde húmedo. Se ven solapes y diferencias de brillo.", solution: "Imprimación uniforme, rodillo de pelo adecuado al acabado, aplicación por paños completos y dos manos cruzadas." },
    { title: "Desconchones en cocinas y baños", problem: "Pintura plástica estándar en zonas de vapor y grasa. Se ampolla y se levanta.", solution: "Pinturas específicas para cocinas y baños, satinadas o mate lavable con resistencia a la condensación." },
    { title: "Esquinas y encuentros torcidos", problem: "Recortes a pulso entre pared y techo o entre dos colores que ondulan y ensucian el resultado.", solution: "Cinta de baja adherencia sobre superficie sellada, recorte con brocha angular y retirada de la cinta en fresco." },
    { title: "Gotelé mal alisado", problem: "Plaste aplicado en una capa gruesa sin lijar: la pared queda ondulada y la textura se transparenta.", solution: "Alisado en dos o tres capas finas a llana, lijado entre capas con luz rasante e imprimación selladora antes de pintar." },
  ]}
