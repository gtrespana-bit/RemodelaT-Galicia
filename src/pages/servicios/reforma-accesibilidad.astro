    { src: "/images/bano-ducha-walkin.webp", alt: "Ducha walk-in sin escalón ni mampara, con paredes continuas", caption: "Ducha walk-in sin escalón" },
    { src: "/images/bano-suelo-antideslizante.webp", alt: "Suelo de baño en porcelánico antideslizante efecto piedra", caption: "Porcelánico antideslizante" },
