---
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from '../components/GodHero.astro';
import GodMarquee from '../components/GodMarquee.astro';
import MethodComparison from '../components/MethodComparison.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';
import { BRAND, COPY, waLink } from '../data/brand';

const whatsappText = 'Hola, quiero una valoración técnica para mi proyecto de reforma';

const getSrcSet = (baseName, widths, ext = 'webp') => {
  return widths.map(w => `/images/${baseName}-${w}.${ext} ${w}w`).join(', ');
};

const serviceImages = {
  cocina: { src: '/images/cocina-800.webp', srcset: getSrcSet('cocina', [400, 800, 1600]) },
  bano: { src: '/images/bano-800.webp', srcset: getSrcSet('bano', [400, 800, 1600]) },
  electricidad: { src: '/images/electricidad-800.webp', srcset: getSrcSet('electricidad', [400, 800, 1600]) },
  fontaneria: { src: '/images/fontaneria-800.webp', srcset: getSrcSet('fontaneria', [400, 800, 1600]) },
  revestimientos: { src: '/images/revestimientos-800.webp', srcset: getSrcSet('revestimientos', [400, 800, 1600]) },
  sueloPorcelánico: { src: '/images/suelo-porcelanico-800.webp', srcset: getSrcSet('suelo-porcelanico', [400, 800, 1600]) },
  integrales: { src: '/images/integrales-800.webp', srcset: getSrcSet('integrales', [400, 800, 1600]) },
  pintura: { src: '/images/pintura-800.webp', srcset: getSrcSet('pintura', [400, 800, 1600]) }
};

const services = [
  { title: "Reforma Integral", kicker: "Desde 29.000 €", desc: "Viviendas completas con planificación técnica, coordinación de oficios y acabados de alto estándar.", image: serviceImages.integrales, link: "/servicios/reforma-integral" },
  { title: "Cocinas", kicker: "Desde 5.000 €", desc: "Mobiliario a medida, encimeras, iluminación técnica y herrajes duraderos.", image: serviceImages.cocina, link: "/servicios/reforma-cocina" },
  { title: "Baños", kicker: "Desde 5.800 €", desc: "Impermeabilización comprobada, pendientes correctas, sanitarios y grifería de calidad.", image: serviceImages.bano, link: "/servicios/reforma-bano" },
  { title: "Suelos y Revestimientos", kicker: "Gran formato", desc: "Porcelánico de gran formato, microcemento, parquet y piezas instaladas con soporte y adhesivo adecuados.", image: serviceImages.sueloPorcelánico, link: "/servicios/suelos-revestimientos" },
  { title: "Revestimientos de Pared", kicker: "Piedra y madera", desc: "Paneles, piedra, madera y microcemento con cortes limpios y encuentros cuidados.", image: serviceImages.revestimientos, link: "/servicios/revestimientos-pared" },
  { title: "Pintura y Acabados", kicker: "Acabado fino", desc: "Preparación profesional de superficies, corrección de imperfecciones y terminaciones limpias.", image: serviceImages.pintura, link: "/servicios/pintura-acabados" },
  { title: "Instalaciones Eléctricas", kicker: "Iluminación técnica", desc: "Cuadros, cableado, iluminación LED y protecciones dimensionadas dentro de proyectos de reforma.", image: serviceImages.electricidad, link: "/servicios/instalacion-electrica" },
  { title: "Fontanería", kicker: "Pruebas de presión", desc: "Renovación de tuberías, puntos de agua, desagües y pruebas de funcionamiento.", image: serviceImages.fontaneria, link: "/servicios/fontaneria" },
  { title: "Adaptación y Accesibilidad", kicker: "Sin barreras", desc: "Baños adaptados, eliminación de barreras y puertas correderas para ganar comodidad y seguridad.", image: serviceImages.bano, link: "/servicios/reforma-accesibilidad" }
];

const processSteps = [
  { step: "01", title: "Diagnóstico técnico", desc: "Medimos, revisamos instalaciones, soportes, humedades y condiciones reales antes de prometer una solución." },
  { step: "02", title: "Presupuesto por partidas", desc: "Recibes una propuesta desglosada y cerrada: alcance, calidades, tiempos, exclusiones y garantía por escrito." },
  { step: "03", title: "Ejecución supervisada", desc: "Equipo propio, responsable técnico en obra y pruebas de instalaciones antes de cerrar." },
  { step: "04", title: "Control de acabados", desc: "Revisión de remates, juntas, cortes y limpieza final antes de entregar." },
  { step: "05", title: "Entrega documentada", desc: "Entrega conjunta, checklist de acabados y garantía por partidas, por escrito." }
];

const qualityPillars = [
  { title: "No usamos soluciones genéricas", desc: "Cada adhesivo, impermeabilizante, tubería o protección se elige según soporte, uso, formato y exposición." },
  { title: "Lo oculto se prueba antes de cerrar", desc: "Instalaciones, pendientes e impermeabilización se revisan antes de cubrirlas con acabados costosos." },
  { title: "Acabados revisados al detalle", desc: "Alineaciones, juntas, cortes, esquinas, sellados y limpieza final forman parte de la entrega, no son extras." }
];

const comparisonRows = [
  ["Material elegido solo por disponibilidad", "Material especificado según soporte, uso y ficha técnica"],
  ["Instalaciones cerradas sin evidencia de pruebas", "Pruebas y revisión antes de cubrir paredes, suelos o techos"],
  ["Presupuesto global difícil de controlar", "Presupuesto por partidas, alcance definido y condiciones claras"],
  ["El acabado depende del oficio del día", "Supervisión directa, checklist de remates y garantía por escrito"]
];

const serviceAreas = [
  { name: 'A Coruña', href: '/reforma-integral-a-coruna/' },
  { name: 'Arteixo', href: '/reforma-integral-arteixo/' },
  { name: 'Oleiros', href: '/reforma-integral-oleiros/' },
  { name: 'Culleredo', href: '/reforma-integral-culleredo/' },
  { name: 'Cambre', href: '/reforma-integral-cambre/' },
  { name: 'Sada', href: '/reforma-integral-sada/' },
  { name: 'Bergondo', href: '/reforma-integral-bergondo/' },
  { name: 'Betanzos', href: '/reforma-integral-betanzos/' },
  { name: 'Carral', href: '/reforma-integral-carral/' },
  { name: 'Abegondo', href: '/reforma-integral-abegondo/' }
];
---

<BaseLayout
  title="Reformas en A Coruña | RemodelaT Coruña"
  description="Reformas de viviendas en A Coruña: reforma integral, cocinas y baños con método técnico, presupuesto por partidas y garantía por escrito."
  activePage="inicio"
>

  <GodHero
    eyebrow="Reformas de viviendas en A Coruña y área metropolitana"
    title="Reformas de alto estándar"
    titleGold="documentadas al detalle"
    lead="Reformas integrales, cocinas y baños con método técnico: diagnóstico, presupuesto por partidas, ejecución supervisada y garantía por escrito."
    image="/images/integrales-800.webp"
    imageAlt="Reforma integral de vivienda en A Coruña con acabados de alto estándar"
    badges={["A Coruña y área metropolitana", "Método técnico", "Garantía por escrito"]}
    watermark="A CORUÑA"
  >
    <div class="god-hero-actions">
      <a href="/contacto/" class="btn-premium btn-primary-premium"><span class="btn-content">Pedir presupuesto</span><span class="btn-arrow">→</span></a>
      <a href="/metodo-remodelat/" class="btn-premium btn-outline-premium"><span class="btn-content">Ver cómo trabajamos</span><span class="btn-arrow">→</span></a>
    </div>
  </GodHero>

  <GodMarquee />

  <section class="section god-manifesto" data-reveal>
    <div class="container god-manifesto-inner">
      <span class="eyebrow-god">Nuestro posicionamiento</span>
      <p>«{COPY.es.positioning}»</p>
    </div>
  </section>

  <div class="premium-divider"><i></i></div>

  <section class="services-page god-services">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Servicios</span>
        <h2 class="section-title">Reformas integrales, cocinas, baños y obra completa</h2>
        <p class="section-desc">Proyectos de reforma completos, ejecutados con equipo propio y supervisados por el responsable técnico en obra.</p>
      </div>
      <div class="services-vertical-grid">
        {services.map((svc) => (
          <a href={svc.link} class="service-vertical-card" data-reveal>
            <div class="card-img-wrap">
              <img
                src={svc.image.src}
                srcset={svc.image.srcset}
                sizes="(max-width: 768px) 100vw, 50vw"
                alt={svc.title}
                loading="lazy"
                decoding="async"
                width="800"
                height="533"
              />
              <div class="card-overlay"></div>
              <span class="home-service-kicker">{svc.kicker}</span>
            </div>
            <div class="card-body">
              <h3>{svc.title}</h3>
              <p>{svc.desc}</p>
              <span class="card-link">Ver más detalles <span class="arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <div class="home-more-services" data-reveal>
        <a href="/servicios/" class="btn-premium btn-outline-premium"><span class="btn-content">Ver todos los servicios</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section bg-light" data-reveal>
    <div class="container">
      <div class="section-header">
        <span class="eyebrow-god on-light">Por qué confiar</span>
        <h2 class="section-title">Tres compromisos de trabajo</h2>
      </div>
      <div class="pillars-grid">
        {qualityPillars.map((p) => (
          <article class="pillar-card">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Cómo trabajamos</span>
        <h2 class="section-title">Método en 10 etapas controladas</h2>
        <p class="section-desc">Del diagnóstico a la entrega documentada, cada fase reduce riesgo y evita improvisaciones.</p>
      </div>
      <div class="process-grid">
        {processSteps.map((s) => (
          <article class="process-card" data-reveal>
            <span class="process-num">{s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
      <div class="home-more-services" data-reveal>
        <a href="/metodo-remodelat/" class="btn-premium btn-outline-premium"><span class="btn-content">Ver el método completo</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="comparison-god section">
    <div class="container">
      <div class="section-header on-dark" data-reveal>
        <span class="eyebrow-god">La diferencia</span>
        <h2>Obra improvisada vs. obra con método</h2>
      </div>
      <MethodComparison rows={comparisonRows} leftLabel="Sin método" rightLabel="Método RemodelaT" />
    </div>
  </section>

  <GuaranteeMatrix variant="light" />

  <section class="section bg-light">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Zona de trabajo</span>
        <h2 class="section-title">A Coruña y área metropolitana</h2>
        <p class="section-desc">Trabajamos en la ciudad de A Coruña y en los municipios de su área metropolitana.</p>
      </div>
      <div class="area-chips" data-reveal>
        {serviceAreas.map((a) => (
          <a href={a.href}>{a.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="god-cta">
    <div class="cta-wrapper">
      <span class="eyebrow-god">Presupuesto por partidas</span>
      <h2 class="cta-title">Cuéntanos tu proyecto en <span class="gold">A Coruña</span></h2>
      <p class="cta-text">Te hacemos una visita técnica sin compromiso, tomamos medidas y te enviamos un presupuesto por partidas, claro y cerrado.</p>
      <div class="cta-actions-home">
        <a href="/contacto/" class="btn-premium btn-primary-premium"><span class="btn-content">Solicitar presupuesto</span><span class="btn-arrow">→</span></a>
        <a href={waLink(whatsappText)} class="btn-premium btn-outline-premium" target="_blank" rel="noopener"><span class="btn-content">WhatsApp</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .god-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
  .home-more-services { display: flex; justify-content: center; margin-top: 40px; }
  .home-service-kicker { position: absolute; left: 18px; bottom: 16px; z-index: 2; background: rgba(201,169,97,.94); color: var(--ink); border-radius: var(--r-full); padding: 6px 12px; font-size: .71rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pillar-card { background: var(--white); border: 1px solid var(--sand); border-radius: var(--r-md); padding: 32px 28px; box-shadow: var(--e-1); }
  .pillar-card h3 { font-family: var(--font-serif); font-size: 1.35rem; margin-bottom: 10px; color: var(--ink); }
  .pillar-card p { color: var(--text-muted); font-size: .95rem; line-height: 1.66; }
  .process-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px; }
  .process-card { background: var(--white); border: 1px solid var(--sand); border-radius: var(--r-md); padding: 26px 22px; box-shadow: var(--e-1); }
  .process-num { font-family: var(--font-serif); font-size: 2rem; color: rgba(201,169,97,.6); display: block; margin-bottom: 10px; }
  .process-card h3 { font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 8px; color: var(--ink); }
  .process-card p { color: var(--text-muted); font-size: .88rem; line-height: 1.6; }
  .comparison-god { background: var(--ink); border-top: var(--hairline); border-bottom: var(--hairline); }
  .area-chips { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .area-chips a {
    display: inline-flex; align-items: center;
    padding: 11px 16px; border-radius: var(--r-full);
    border: 1px solid rgba(201,169,97,.3);
    background: var(--bone); color: var(--gold-ink-strong);
    text-decoration: none; font-weight: 700; font-size: .88rem;
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .area-chips a:hover { background: var(--gold); color: var(--ink); transform: translateY(-2px); }
  .cta-actions-home { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 8px; }

  @media (max-width: 1100px) {
    .process-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .process-grid { grid-template-columns: 1fr; }
    .cta-actions-home { flex-direction: column; align-items: center; width: 100%; }
    .god-hero-actions { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    targets.forEach(el => io.observe(el));
  })();
</script>
